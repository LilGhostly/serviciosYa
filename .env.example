# Plantilla de variables de entorno del frontend (Vite).
# Copia este archivo como ".env" en la raíz del proyecto y completa los
# valores reales. El archivo ".env" real NUNCA se sube al repositorio
# (ver .gitignore).

# Clave de la API de Google Maps (Places/Autocomplete), usada en Solicitar.jsx
# para la búsqueda de direcciones. OPCIONAL: si se deja vacía, el paso de
# ubicación usa automáticamente un formulario de dirección manual (sin mapa
# ni autocompletado), para que el proyecto no dependa de una cuenta de
# Google Cloud con facturación habilitada. Restringir por dominio/HTTP
# referrer en Google Cloud Console si se completa.
VITE_GOOGLE_MAPS_API_KEY=

# Configuración del proyecto de Firebase (Auth, Firestore, Storage, Functions).
# Se obtiene desde Firebase Console → Configuración del proyecto → Tus apps.
# A diferencia de la clave de Maps o las credenciales de pago/IA, esta
# configuración SÍ es necesaria siempre: es la identidad del propio backend
# de la aplicación (protegido por firestore.rules / storage.rules, no por
# mantener esta configuración en secreto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
