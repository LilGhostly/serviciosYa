# Plantilla de variables de entorno para functions/ (Cloud Functions).
# Copia este archivo como ".env" en la misma carpeta y completa los valores
# reales si vas a conectar credenciales reales. El archivo ".env" real
# NUNCA se sube al repositorio (ver .gitignore).

# ─────────────────────────────────────────────────────────────
# MODOS DE OPERACIÓN
# Por defecto ambas integraciones corren en modo "mock" (simulado): la
# aplicación funciona de punta a punta sin necesitar ninguna cuenta real
# de Mercado Pago ni de Google Cloud Vision. Ver docs/PAGOS_Y_VERIFICACION.md.
# Cambia a "live" solo si vas a completar las credenciales reales de abajo.
# ─────────────────────────────────────────────────────────────
PAYMENTS_MODE=mock
IDENTITY_VERIFICATION_MODE=mock

# ─────────────────────────────────────────────────────────────
# Credenciales reales (solo necesarias si el modo correspondiente es "live")
# ─────────────────────────────────────────────────────────────

# Token de acceso de Mercado Pago (Checkout Pro). Se obtiene desde el panel
# de credenciales de la cuenta de Mercado Pago del proyecto.
MP_ACCESS_TOKEN=

# Ruta al archivo JSON de la cuenta de servicio de Google Cloud, usada por
# Vision API para la verificación de identidad. Solo necesaria en desarrollo
# local con IDENTITY_VERIFICATION_MODE=live: en producción (Cloud Functions
# desplegado), el SDK usa automáticamente la cuenta de servicio por defecto
# del entorno de ejecución y esta variable debe dejarse vacía / no definirse.
GOOGLE_APPLICATION_CREDENTIALS=
